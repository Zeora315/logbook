{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logbook-api",
  "main": "worker.js",
  "compatibility_date": "2026-07-26",
  "kv_namespaces": [
    {
      "binding": "LOG_KV",
      "id": "replace-with-production-kv-namespace-id"
    }
  ],
  "vars": {
    "SITE_TITLE": "我的更新日志",
    "SITE_DESCRIPTION": "记录 Zeora 和虾米的更新、发布与想法。",
    "FRONTEND_ORIGIN": "*"
  }
}