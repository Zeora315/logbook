{
  // Zeora Logbook · 独立 Worker 配置
  // 用法：
  //   1. 先在 Cloudflare Dashboard 创建 KV namespace（名称 LOG_KV）
  //   2. 把下面的 id 替换成你的 KV namespace ID
  //   3. 运行 npm run deploy:worker 部署
  //
  // 如果不想用 CLI，也可以直接把 worker-standalone.js 的内容
  // 复制到 Cloudflare Worker 编辑器里手动部署。

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeora-logbook",
  "main": "worker.js",
  "compatibility_date": "2026-07-26",

  // KV 绑定 —— id 替换成你的 KV namespace ID
  "kv_namespaces": [
    {
      "binding": "LOG_KV",
      "id": "替换成你的KV_NAMESPACE_ID"
    }
  ],

  // 环境变量（敏感信息建议用 Cloudflare Dashboard 的 Secrets 设置）
  "vars": {
    "SITE_TITLE": "我的更新日志",
    "SITE_DESCRIPTION": "记录 Zeora 和虾米的更新、发布与想法。",
    "FRONTEND_ORIGIN": "*"
    // ADMIN_USERNAME / ADMIN_PASSWORD / ADMIN_API_TOKEN
    //   请在 Cloudflare Dashboard → Worker → Settings → Variables 里
    //   设为 Encrypted 类型（Secret），不要写在这里。
  }
}
