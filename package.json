{
  "name": "zeora-logbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2026-07-26",
    "dev:worker": "wrangler dev --config wrangler.worker.jsonc",
    "check": "node --check public/assets/app.js && node --check public/assets/admin.js && node --check functions/_lib/changelog.js && node --check worker.js",
    "deploy:worker": "wrangler deploy --config wrangler.worker.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.25.0"
  }
}
